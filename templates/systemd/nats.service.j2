[Unit]
Description=Nextcloud Talk HPB NATS ({{ nextcloud_talk_hpb_nats_identifier }})
{% for service in nextcloud_talk_hpb_nats_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in nextcloud_talk_hpb_nats_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ nextcloud_talk_hpb_nats_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ nextcloud_talk_hpb_nats_identifier }} \
      --log-driver=none \
      --user={{ nextcloud_talk_hpb_uid }}:{{ nextcloud_talk_hpb_gid }} \
      --read-only \
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ nextcloud_talk_hpb_nats_container_tmpfs_tmp_size }},mode=1777 \
      --cap-drop=ALL \
      --security-opt=no-new-privileges \
      --network={{ nextcloud_talk_hpb_hpb_network }} \
      --ip={{ nextcloud_talk_hpb_nats_container_ip }} \
      --mount type=bind,src={{ nextcloud_talk_hpb_base_path }}/nats.conf,dst=/etc/nats/nats.conf,readonly \
      {{ nextcloud_talk_hpb_nats_container_image }} \
      -c /etc/nats/nats.conf

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ nextcloud_talk_hpb_nats_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ nextcloud_talk_hpb_nats_container_stop_grace_time_seconds }} {{ nextcloud_talk_hpb_nats_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ nextcloud_talk_hpb_nats_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ nextcloud_talk_hpb_nats_identifier }}

[Install]
WantedBy=multi-user.target
