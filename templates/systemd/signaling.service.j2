[Unit]
Description=Nextcloud Talk HPB signaling server ({{ nextcloud_talk_hpb_signaling_identifier }})
{% for service in nextcloud_talk_hpb_signaling_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in nextcloud_talk_hpb_signaling_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ nextcloud_talk_hpb_signaling_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ nextcloud_talk_hpb_signaling_identifier }} \
      --log-driver=none \
      --user={{ nextcloud_talk_hpb_uid }}:{{ nextcloud_talk_hpb_gid }} \
      --read-only \
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ nextcloud_talk_hpb_signaling_container_tmpfs_tmp_size }},mode=1777 \
      --cap-drop=ALL \
      --security-opt=no-new-privileges \
      --init \
      --stop-signal=SIGUSR1 \
      --network={{ nextcloud_talk_hpb_hpb_network }} \
      --publish={{ nextcloud_talk_hpb_signaling_container_http_host_bind_port }}:{{ nextcloud_talk_hpb_signaling_container_http_port }} \
      --mount type=bind,src={{ nextcloud_talk_hpb_base_path }}/signaling.conf,dst=/etc/signaling/server.conf,readonly \
      --label-file={{ nextcloud_talk_hpb_base_path }}/signaling.labels \
      {{ nextcloud_talk_hpb_signaling_container_image }} \
      -config /etc/signaling/server.conf

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ nextcloud_talk_hpb_egress_network }} {{ nextcloud_talk_hpb_signaling_identifier }}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ nextcloud_talk_hpb_proxy_network }} {{ nextcloud_talk_hpb_signaling_identifier }}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ nextcloud_talk_hpb_signaling_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ nextcloud_talk_hpb_signaling_container_stop_grace_time_seconds }} {{ nextcloud_talk_hpb_signaling_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ nextcloud_talk_hpb_signaling_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ nextcloud_talk_hpb_signaling_identifier }}

[Install]
WantedBy=multi-user.target
