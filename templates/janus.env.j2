# {{ ansible_managed }}
{% set signaling_event_port = (nextcloud_talk_hpb_signaling_container_http_host_bind_port | string).split(':')[-1] | default(nextcloud_talk_hpb_signaling_container_http_port, true) %}
{#
  Janus matches `ws_acl` entries as address *prefixes* (`strstr(ip, allowed) == ip`),
  not as CIDR networks, so the egress subnet is reduced to its address prefix.
  This assumes the egress network is a /24 (the role's default).
#}
{% set ws_acl = (nextcloud_talk_hpb_egress_subnet.split('/')[0].split('.')[0:3] | join('.') ~ '.') if '.' in nextcloud_talk_hpb_egress_subnet else nextcloud_talk_hpb_egress_subnet.split('/')[0] %}
JANUS_TURN_SERVER={{ nextcloud_talk_hpb_janus_turn_server_host }}
JANUS_TURN_PORT={{ nextcloud_talk_hpb_janus_turn_server_port }}
JANUS_TURN_SECRET={{ nextcloud_talk_hpb_turn_static_auth_secret }}
JANUS_EVENT_BACKEND=ws://127.0.0.1:{{ signaling_event_port }}/spreed
JANUS_WS_IP={{ nextcloud_talk_hpb_egress_gateway }}
JANUS_WS_ACL={{ ws_acl }}
JANUS_WS_PORT=8188
JANUS_HTTP_IP=127.0.0.1
JANUS_HTTP_PORT=8088
JANUS_HTTP_ACL=127.0.0.1
JANUS_NAT_1_1_MAPPING={{ nextcloud_talk_hpb_public_ip }}
JANUS_RTP_PORT_RANGE={{ nextcloud_talk_hpb_janus_rtp_port_range }}
